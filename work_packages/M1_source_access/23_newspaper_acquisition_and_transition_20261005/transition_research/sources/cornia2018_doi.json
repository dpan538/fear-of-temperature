{"data":{"id":"10.60625/risj-cg3f-he14","type":"dois","attributes":{"doi":"10.60625/risj-cg3f-he14","prefix":"10.60625","suffix":"risj-cg3f-he14","identifiers":[],"alternateIdentifiers":[],"creators":[{"name":"Cornia, Alessio","nameType":"Personal","givenName":"Alessio","familyName":"Cornia","affiliation":["University of Oxford"],"nameIdentifiers":[]},{"name":"Sehl, Annika","nameType":"Personal","givenName":"Annika","familyName":"Sehl","affiliation":["University of Oxford"],"nameIdentifiers":[]},{"name":"Levy, David A. L.","nameType":"Personal","givenName":"David A. L.","familyName":"Levy","affiliation":["University of Oxford"],"nameIdentifiers":[]},{"name":"Nielsen, Rasmus Kleis","nameType":"Personal","givenName":"Rasmus Kleis","familyName":"Nielsen","affiliation":["University of Oxford"],"nameIdentifiers":[]}],"titles":[{"lang":"en","title":"Private sector news, social media distribution, and algorithm change","titleType":null}],"publisher":"Reuters Institute for the Study of Journalism","container":{},"publicationYear":2018,"subjects":[],"contributors":[],"dates":[],"language":"en","types":{"ris":"RRPT","bibtex":"misc","citeproc":"report","schemaOrg":"Report","resourceTypeGeneral":"Report"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":null,"rightsList":[{"rights":"Creative Commons Attribution 2.0 Generic","rightsUri":"https://creativecommons.org/licenses/by/2.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-2.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"lang":"ee","description":"In this report, we examine how private sector legacy news organisations across six European countries use social media for news distribution. We analyse in particular how strategies vary across different news organisations and across platforms, with a section focusing on how publishers have responded to the January 2018 changes to Facebook’s algorithm. Based on 21 interviews with editors and mangers at 12 newspapers and commercial broadcasters, we find that, even though many news organisations are frustrated by limited direct monetisation and frequent algorithm changes, they still concentrate on Facebook their resources for social media distribution. The impact of Facebook algorithm change varies across organisations, but is in most cases far from the apocalyptic scenarios anticipated by some commentators. There is no clear pattern to explain this variation, but broadly the organisations that increased their activity on Facebook have seen a smaller decline in interactions than others, and in some cases growth. ","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://reutersinstitute.politics.ox.ac.uk/our-research/private-sector-news-social-media-distribution-and-algorithm-change","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"fabricaForm","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2023-11-01T12:57:42.000Z","registered":"2023-11-07T12:41:02.000Z","published":"2018","updated":"2023-11-08T11:27:42.000Z"},"relationships":{"client":{"data":{"id":"ylyl.risj","type":"clients"}},"provider":{"data":{"id":"ylyl","type":"providers"}},"media":{"data":{"id":"10.60625/risj-cg3f-he14","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}