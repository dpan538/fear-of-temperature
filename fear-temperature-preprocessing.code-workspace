      "**/.cache": true,
      "**/.venv": true,
      "**/archives": true,
      "**/models": true,
      "**/work_packages": true,
      "**/outputs": true
    }
  },
  "extensions": {
    "recommendations": ["ms-python.python", "ms-toolsai.jupyter", "ms-python.vscode-pylance"]
  }
}
