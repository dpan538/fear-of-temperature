{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Workspace: bootstrap",
      "type": "shell",
      "command": "./scripts/bootstrap.sh",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Workspace: doctor",
      "type": "shell",
      "command": ".venv/bin/fear-temperature-doctor --full-models",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Tests: pytest",
      "type": "shell",
      "command": ".venv/bin/pytest",
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Demo: full synthetic pipeline",
      "type": "shell",
      "command": ".venv/bin/fear-temperature-demo --offline",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Notebooks: execute all",
      "type": "shell",
      "command": "./scripts/run_notebooks.sh",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Figures: regenerate demo exports",
      "type": "shell",
      "command": ".venv/bin/fear-temperature-demo --offline",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Legacy: validate lexical/Ngram baseline",
      "type": "shell",
      "command": ".venv/bin/python scripts/fear-temperature/validate_quantitative_baseline.py",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
